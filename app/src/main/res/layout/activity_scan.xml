<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qx_scan_bg">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_scan"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/qx_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Scan"
            android:textColor="@color/qx_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnAutoZoom"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_accent"
            android:contentDescription="Auto zoom"
            android:src="@drawable/ic_zoom" />

        <ImageButton
            android:id="@+id/btnTorch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_circle_scan"
            android:contentDescription="Flashlight"
            android:src="@drawable/ic_flash_off"
            android:visibility="gone"
            app:tint="@color/qx_text" />
    </LinearLayout>

    <!-- The camera lives ONLY inside this rounded frame -->
    <FrameLayout
        android:id="@+id/frameCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="36dp"
        android:background="@drawable/bg_scan_frame"
        android:clipToOutline="true"
        android:outlineProvider="background"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />

        <TextView
            android:id="@+id/txtZoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_zoom_badge"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="1.0×"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.qrix.scanner.ScanOverlayView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <TextView
        android:id="@+id/txtHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="Align the code inside the frame"
        android:textColor="@color/qx_text"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/frameCard" />

    <TextView
        android:id="@+id/txtHint2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="QR codes and barcodes · pinch to zoom"
        android:textColor="@color/qx_text_dim"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtHint" />

    <!-- Zoom presets -->
    <LinearLayout
        android:id="@+id/zoomBar"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_zoom_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtHint2">

        <TextView
            android:id="@+id/zoom1"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_zoom_chip"
            android:gravity="center"
            android:text="1×"
            android:textColor="@color/zoom_chip_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/zoom2"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_zoom_chip"
            android:gravity="center"
            android:text="2×"
            android:textColor="@color/zoom_chip_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/zoom3"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_zoom_chip"
            android:gravity="center"
            android:text="3×"
            android:textColor="@color/zoom_chip_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Gallery -->
    <LinearLayout
        android:id="@+id/btnGallery"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_gallery_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_image"
            app:tint="@color/qx_scan_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Scan from gallery"
            android:textColor="@color/qx_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Camera permission needed -->
    <LinearLayout
        android:id="@+id/permissionView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/qx_scan_overlay"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Camera permission is needed\nto scan codes"
            android:textColor="@color/qx_text"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrant"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="20dp"
            android:text="Allow camera" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPermGallery"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="Scan from gallery instead" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
